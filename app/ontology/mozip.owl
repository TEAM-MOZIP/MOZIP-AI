@prefix mz: <http://mozip.ai/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# MOZIP 온톨로지 MVP 스키마
#
# 개념 범위는 추측이 아니라 docs/ai-integration/ontology-server-fields.md에 정리된
# MOZIP-SERVER 실제 필드/enum 기준을 따른다. SERVER에 구조화 필드·enum이 없는 개념
# (Interest, TargetGroup, PolicyPurpose, SupportType, LifeCycle)은 포함하지 않는다.

<http://mozip.ai/ontology>
    a owl:Ontology ;
    rdfs:comment "MOZIP 온톨로지 MVP 스키마"@ko .

#################################################################
# 최상위 개념
#################################################################

mz:UserConcept a owl:Class ;
    rdfs:label "사용자 개념"@ko .

mz:PolicyConcept a owl:Class ;
    rdfs:label "정책 개념"@ko .

#################################################################
# UserConcept 하위 클래스
#################################################################

mz:EmploymentStatus a owl:Class ;
    rdfs:subClassOf mz:UserConcept ;
    rdfs:label "고용 상태"@ko ;
    rdfs:comment "SERVER UserProfile.employmentStatus (EmploymentStatus)"@ko .

mz:HouseholdType a owl:Class ;
    rdfs:subClassOf mz:UserConcept ;
    rdfs:label "가구 형태"@ko ;
    rdfs:comment "SERVER UserProfile.householdType (HouseholdType)"@ko .

mz:IncomeType a owl:Class ;
    rdfs:subClassOf mz:UserConcept ;
    rdfs:label "소득 유형"@ko ;
    rdfs:comment "SERVER UserProfile.incomeType / PolicyEligibility.incomeType (IncomeType)"@ko .

mz:Gender a owl:Class ;
    rdfs:subClassOf mz:UserConcept ;
    rdfs:label "성별"@ko ;
    rdfs:comment "값 도메인은 확정(MALE/FEMALE)되었으나 SERVER API는 아직 자유 문자열을 반환한다 (enum 전환 구현 대기). 매핑 시 허용값 외 문자열은 버려야 한다."@ko .

mz:AgeGroup a owl:Class ;
    rdfs:subClassOf mz:UserConcept ;
    rdfs:label "연령대"@ko ;
    rdfs:comment "잠정안. SERVER에는 연령 구간 enum이 없고 birthDate/minimumAge/maximumAge 숫자만 있다. MOZIP-AI가 의미 관련도 계산용으로 임시 정의했으며, 확정적 자격 판정에는 사용하지 않는다. 추후 SERVER와 협의해 조정될 수 있다."@ko .

mz:Region a owl:Class ;
    rdfs:subClassOf mz:UserConcept ;
    rdfs:label "지역"@ko ;
    rdfs:comment "SERVER regions 테이블. 시드 데이터가 없어 이번 MVP에서는 클래스만 정의하고 인스턴스는 비워둔다."@ko .

#################################################################
# PolicyConcept 하위 클래스
#################################################################

mz:RegionScope a owl:Class ;
    rdfs:subClassOf mz:PolicyConcept ;
    rdfs:label "지역 범위"@ko ;
    rdfs:comment "SERVER Policy.regionScope (RegionScope)"@ko .

mz:ApplicationType a owl:Class ;
    rdfs:subClassOf mz:PolicyConcept ;
    rdfs:label "신청 방식"@ko ;
    rdfs:comment "SERVER Policy.applicationType (ApplicationType)"@ko .

mz:PolicyStatus a owl:Class ;
    rdfs:subClassOf mz:PolicyConcept ;
    rdfs:label "정책 상태"@ko ;
    rdfs:comment "SERVER Policy.status (PolicyStatus)"@ko .

mz:Category a owl:Class ;
    rdfs:subClassOf mz:PolicyConcept ;
    rdfs:label "정책 카테고리"@ko ;
    rdfs:comment "SERVER categories 테이블. 시드 데이터가 없어 이번 MVP에서는 클래스만 정의하고 인스턴스는 비워둔다."@ko .

#################################################################
# 관계 (Object Properties)
#
# 매핑/관련도 계산 이슈에서 실제 인스턴스 간 관계로 사용한다.
# 이번 이슈에서는 관계 자체(속성)만 정의하고, 인스턴스 간 관계 트리플은 만들지 않는다.
#################################################################

mz:isA a owl:ObjectProperty ;
    rdfs:label "IS_A"@en .

mz:partOf a owl:ObjectProperty ;
    rdfs:label "PART_OF"@en .

mz:targets a owl:ObjectProperty ;
    rdfs:label "TARGETS"@en .

mz:requires a owl:ObjectProperty ;
    rdfs:label "REQUIRES"@en .

mz:availableIn a owl:ObjectProperty ;
    rdfs:label "AVAILABLE_IN"@en .

mz:relatedTo a owl:ObjectProperty ;
    rdfs:label "RELATED_TO"@en .

#################################################################
# EmploymentStatus 값
#################################################################

mz:EMPLOYED a mz:EmploymentStatus ; rdfs:label "재직중"@ko .
mz:UNEMPLOYED a mz:EmploymentStatus ; rdfs:label "미취업"@ko .
mz:JOB_SEEKER a mz:EmploymentStatus ; rdfs:label "구직중"@ko .

#################################################################
# HouseholdType 값
#################################################################

mz:SINGLE a mz:HouseholdType ; rdfs:label "1인 가구"@ko .
mz:ELDERLY a mz:HouseholdType ; rdfs:label "노인 가구"@ko .
mz:SINGLE_PARENT a mz:HouseholdType ; rdfs:label "한부모 가구"@ko .
mz:DISABLED a mz:HouseholdType ; rdfs:label "장애인 가구"@ko .

#################################################################
# IncomeType 값
#################################################################

mz:ABSOLUTE a mz:IncomeType ; rdfs:label "절대 소득"@ko .
mz:MEDIAN_PERCENTAGE a mz:IncomeType ; rdfs:label "기준중위소득 비율"@ko .

#################################################################
# Gender 값
#################################################################

mz:MALE a mz:Gender ; rdfs:label "남성"@ko .
mz:FEMALE a mz:Gender ; rdfs:label "여성"@ko .

#################################################################
# AgeGroup 값 (잠정안)
#################################################################

mz:Minor a mz:AgeGroup ;
    rdfs:label "미성년자"@ko ;
    rdfs:comment "만 19세 미만 (잠정)"@ko .

mz:Youth a mz:AgeGroup ;
    rdfs:label "청년"@ko ;
    rdfs:comment "만 19세~34세 (잠정, 청년기본법 기준)"@ko .

mz:MiddleAged a mz:AgeGroup ;
    rdfs:label "중장년"@ko ;
    rdfs:comment "만 35세~64세 (잠정)"@ko .

mz:Senior a mz:AgeGroup ;
    rdfs:label "노년"@ko ;
    rdfs:comment "만 65세 이상 (잠정, 노인복지법 기준)"@ko .

#################################################################
# RegionScope 값
#################################################################

mz:NATIONAL a mz:RegionScope ; rdfs:label "전국"@ko .
mz:REGIONAL a mz:RegionScope ; rdfs:label "지역"@ko .

#################################################################
# ApplicationType 값
#################################################################

mz:PERIOD a mz:ApplicationType ; rdfs:label "기간 신청"@ko .
mz:ALWAYS a mz:ApplicationType ; rdfs:label "상시 신청"@ko .
mz:UNKNOWN a mz:ApplicationType ; rdfs:label "확인 불가"@ko .

#################################################################
# PolicyStatus 값
#################################################################

mz:DRAFT a mz:PolicyStatus ; rdfs:label "초안"@ko .
mz:OPEN a mz:PolicyStatus ; rdfs:label "공개"@ko .
mz:CLOSED a mz:PolicyStatus ; rdfs:label "종료"@ko .
mz:ALWAYS_OPEN a mz:PolicyStatus ; rdfs:label "상시 공개"@ko .
mz:SUSPENDED a mz:PolicyStatus ; rdfs:label "중지"@ko .
